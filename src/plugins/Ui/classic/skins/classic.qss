QMainWindow#ClassicWindow,QDockWidget { background:@shadow@; color:@text@; border:1px solid @edge@; }
QWidget#deck,QWidget#panelBody,QWidget#eqBody {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @metal@,stop:0.08 @body@,stop:0.65 @body@,stop:1 @shadow@);
}
QWidget#chrome,QWidget#transport,QWidget#compactBar {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @edge@,stop:0.16 @shadow@,stop:0.48 @body@,stop:0.63 @metal@,stop:1 @shadow@);
}
QWidget#transport {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @metal@,stop:0.48 @body@,stop:0.51 @shadow@,stop:1 @edge@);}
QWidget#deck QLabel,QWidget#chrome QLabel,QWidget#eqBody QLabel,QWidget#lyricPanel QLabel { color:@text@; background:transparent; }
QWidget#chrome QLabel#caption {color:@muted@; font-size:15px;font-weight:600;}
QLabel#compactTitle {color:@text@;background:transparent;font-weight:600;}
QToolButton#medallion {background:qradialgradient(cx:.4,cy:.36,radius:.7,fx:.36,fy:.29,stop:0 #fff5c8,stop:.48 #e6c177,stop:1 #79613a);color:#493347;border:1px solid #bba36b;border-radius:8px;font:bold 12px serif;}
QWidget#readout {border:1px solid @edge@; border-radius:3px; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @metal@,stop:.45 @body@,stop:.52 @shadow@,stop:1 @edge@);}
QLabel#song,QLabel#clock {font-size:16px;font-weight:600;}
QLabel#clock {font-family:monospace;letter-spacing:1px;}
QWidget#display {border:1px solid @edge@;background:qlineargradient(x1:0,y1:1,x2:1,y2:0,stop:0 @shadow@,stop:.28 @display@,stop:.47 @glow@,stop:.65 @display@,stop:1 @display@);}
QToolButton,QPushButton {color:@text@;padding:0;border:1px solid @edge@;border-top-color:@shine@;border-radius:3px;
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @metal@,stop:.42 @glow@,stop:.49 @metal@,stop:.54 @body@,stop:1 @shadow@);}
QToolButton:hover,QPushButton:hover {border-color:@shine@;}
QToolButton:pressed,QToolButton:checked,QPushButton:pressed {background:@glow@;color:white;}
QToolButton:focus {border-color:@spectrum@;}
QToolButton#consoleKey {font:bold 10px sans-serif;min-width:34px;padding:0px 2px;}
QDockWidget#equalizer QToolButton#consoleKey {min-width:54px;}
QToolButton#round,QToolButton#play {border:2px solid @edge@;border-radius:20px;
 background:qradialgradient(cx:.46,cy:.28,radius:.82,fx:.43,fy:.18,stop:0 @shine@,stop:.31 @metal@,stop:.56 @glow@,stop:.61 @shadow@,stop:.83 @accent@,stop:1 @edge@);}
QToolButton#play {border-radius:30px;}
QToolButton#round:hover,QToolButton#play:hover {border-color:@shine@;}
QToolButton#round:pressed,QToolButton#play:pressed {background:@glow@;}
QToolButton#libraryKey {border-radius:11px;background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @shine@,stop:.48 @metal@,stop:.55 @glow@,stop:1 @accent@);}
QToolButton::menu-indicator {image:none;width:0px;}
QSlider::groove:horizontal {height:4px;background:@edge@;border:1px solid @metal@;border-radius:2px;}
QSlider::sub-page:horizontal {background:@accent@;}
QSlider::handle:horizontal {width:11px;margin:-4px 0;border-radius:5px;border:1px solid @glow@;background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @shine@,stop:.46 @accent@,stop:.5 @glow@,stop:1 @shadow@);}
QSlider::groove:vertical {width:3px;background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 @accent@,stop:.55 @shine@,stop:1 @glow@);border:1px solid @metal@;}
QSlider::handle:vertical {height:9px;margin:0 -3px;border:1px solid @shine@;border-radius:2px;background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @shine@,stop:.48 @metal@,stop:1 @glow@);}
QWidget#eqBody,QWidget#lyricPanel,QListView#tracks,QListWidget#collections {background:@body@;color:@muted@;}
QListView#tracks,QListWidget#collections {font-size:14px;border:1px solid @shadow@;outline:0;selection-color:@text@;selection-background-color:@glow@;}
QListView#tracks::item,QListWidget#collections::item {padding:0 2px;}
QWidget#listTools {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 @metal@,stop:.49 @metal@,stop:.51 @body@,stop:1 @shadow@);}
QWidget#listTools QToolButton {border:0;background:transparent;font-weight:bold;font-size:15px;}
QWidget#listTools QToolButton:hover {background:@glow@;}
QWidget#lyricPanel QLabel#activeLyric {color:@text@;font-weight:bold;font-size:15px;}
QWidget#lyricPanel QLabel#nearLyric,QWidget#eqBody QLabel#eqMark {color:@muted@;}
QMenu {color:@text@;background:@body@;border:1px solid @shine@;padding:3px;}
QMenu::item {padding:4px 22px 4px 14px;}
QMenu::item:selected {background:@glow@;}
QMenu::separator {height:1px;background:@metal@;margin:4px 6px;}
QSplitter::handle {background:@metal@;}

QScrollBar:vertical {width:9px;background:@shadow@;}
QScrollBar::handle:vertical {background:@metal@;border:1px solid @glow@;min-height:12px;}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical {height:0;}

/* Music search and preferences share the console's chrome, inset fields and focus color. */
QDialog[classicDialog="true"] {
    background:@body@; color:@text@; border:1px solid @metal@; font-size:14px;
}
QDialog[classicDialog="true"] QWidget#chrome {
    border-bottom:1px solid @edge@; padding:2px;
}
QDialog[classicDialog="true"] QAbstractItemView {
    background:@shadow@; alternate-background-color:@body@; color:@text@;
    selection-background-color:@glow@; selection-color:@text@;
    border:1px solid @metal@; border-radius:3px; outline:0;
}
QDialog[classicDialog="true"] QListView::item {padding:4px 6px;}
QDialog[classicDialog="true"] QListView::item:selected {background:@glow@;color:@text@;}
QListWidget#contentsWidget::item {padding:7px 8px;border-left:3px solid transparent;}
QListWidget#contentsWidget::item:selected {background:@glow@;border-left:3px solid @spectrum@;}
QDialog[classicDialog="true"] QScrollArea {border:0;background:@body@;}
QDialog[classicDialog="true"] QGroupBox {
    background:@body@;color:@text@;border:1px solid @metal@;border-radius:4px;
    margin-top:10px;padding:9px 6px 5px;
}
QDialog[classicDialog="true"] QGroupBox::title {
    subcontrol-origin:margin;subcontrol-position:top left;left:9px;
    padding:0 5px;color:@spectrum@;background:@body@;
}
QDialog[classicDialog="true"] QLineEdit,QDialog[classicDialog="true"] QComboBox,
QDialog[classicDialog="true"] QAbstractSpinBox {
    color:@text@;background:@shadow@;border:1px solid @metal@;
    border-radius:3px;padding:3px 6px;min-height:18px;
    selection-background-color:@glow@;selection-color:@text@;
}
QDialog[classicDialog="true"] QLineEdit:focus,QDialog[classicDialog="true"] QComboBox:focus,
QDialog[classicDialog="true"] QAbstractSpinBox:focus {border-color:@spectrum@;}
QDialog[classicDialog="true"] QLineEdit:disabled,QDialog[classicDialog="true"] QComboBox:disabled,
QDialog[classicDialog="true"] QAbstractSpinBox:disabled {background:@body@;color:@muted@;}
QDialog[classicDialog="true"] QPushButton {min-height:23px;padding:1px 12px;}
QDialog[classicDialog="true"] QPushButton:disabled {background:@body@;color:@muted@;border-color:@metal@;}
QDialog[classicDialog="true"] QCheckBox {spacing:6px;}
QDialog[classicDialog="true"] QHeaderView::section {
    color:@text@;background:@metal@;padding:4px 6px;border:0;border-right:1px solid @body@;
}
QDialog[classicDialog="true"] QScrollArea > QWidget,
QDialog[classicDialog="true"] QWidget#scrollAreaWidgetContents,
QDialog[classicDialog="true"] QStackedWidget > QWidget {background:@body@;}
QDialog[classicDialog="true"] QLabel,QDialog[classicDialog="true"] QCheckBox {color:@text@;}
QDialog[classicDialog="true"] QLabel:disabled,QDialog[classicDialog="true"] QCheckBox:disabled {color:@muted@;}
QDialog[classicDialog="true"] QCheckBox::indicator {
    width:13px;height:13px;border:1px solid @metal@;border-radius:3px;background:@shadow@;
}
QDialog[classicDialog="true"] QCheckBox::indicator:checked {
    image:url(:/classic/skins/check.svg);background:@glow@;border-color:@shine@;
}
QDialog[classicDialog="true"] QCheckBox::indicator:disabled {border-color:@metal@;background:@body@;}
QDialog[classicDialog="true"] QScrollBar:horizontal {height:9px;background:@shadow@;}
QDialog[classicDialog="true"] QScrollBar::handle:horizontal {background:@metal@;min-width:12px;}
QDialog[classicDialog="true"] QScrollBar::add-line:horizontal,
QDialog[classicDialog="true"] QScrollBar::sub-line:horizontal {width:0;}

QWidget#compactBar QToolButton {
    border-radius:10px; border:1px solid @edge@; border-top-color:@shine@;
    background:qradialgradient(cx:.46,cy:.25,radius:.81,fx:.45,fy:.23,stop:0 @metal@,stop:.6 @body@,stop:1 @edge@);
}
QWidget#compactBar QToolButton:hover { border-color:@shine@; }
QWidget#compactBar QToolButton:pressed { background:@glow@; }
